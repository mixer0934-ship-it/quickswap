{
  "schemaVersion": 1,
  "id": "quickswap",
  "version": "${version}",
  "name": "QuickSwap",
  "description": "Rule-based hotbar swapping with an in-game GUI. Hold item X, press a key, swap to item Y (and optionally back).",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.quickswap.QuickSwapClient"],
    "modmenu": ["com.example.quickswap.ModMenuIntegration"]
  },
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
